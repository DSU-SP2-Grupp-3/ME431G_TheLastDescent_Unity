  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 79a9b0d3c10b22a4a84c5418b36511d6, type: 3}
  m_Name: Intro 2
  m_EditorClassIdentifier: 
  dialogues:
  - name: Knut
    portrait: {fileID: 21300000, guid: 0986f98ebf45a8d4eb7d50867221a24b, type: 3}
    sentences:
    - I appreciate that you saved me. But I must go back to Eden.
  - name: Denali
    portrait: {fileID: 21300000, guid: 9df70db75e70c354eb794e1e51029830, type: 3}
    sentences:
    - Of course, but my grandmother wants to meet you first.
  - name: Knut
    portrait: {fileID: 21300000, guid: 0986f98ebf45a8d4eb7d50867221a24b, type: 3}
    sentences:
    - Your grandmother?
  - name: Denali
    portrait: {fileID: 21300000, guid: 9df70db75e70c354eb794e1e51029830, type: 3}
    sentences:
    - Our village elder. All of us might accompany you back.
  - name: Knut
    portrait: {fileID: 21300000, guid: 0986f98ebf45a8d4eb7d50867221a24b, type: 3}
    sentences:
    - "I see\u2026"
  - name: Denali
    portrait: {fileID: 21300000, guid: 9df70db75e70c354eb794e1e51029830, type: 3}
    sentences:
    - Unless you want to travel back alone?
  - name: Knut
    portrait: {fileID: 21300000, guid: 0986f98ebf45a8d4eb7d50867221a24b, type: 3}
    sentences:
    - "Very well, let\u2019s go ahead."
