  dialogues:
  - name: Knut
    portrait: {fileID: 21300000, guid: 0819b2a39ff19584597e14c64d8fbdf0, type: 3}
    Popup: {fileID: 0}
    sfx: {fileID: 0}
    sentences:
    - I appreciate that you saved me. But I must get back to Eden.
  - name: Denali
    portrait: {fileID: 21300000, guid: 37666a48d1d431849a0bbda42fd7b28e, type: 3}
    Popup: {fileID: 0}
    sfx: {fileID: 0}
    sentences:
    - "Let\u2019s get to our village first. I\u2019m sure my grandma wants to meet
      you."
  - name: Knut
    portrait: {fileID: 21300000, guid: 0819b2a39ff19584597e14c64d8fbdf0, type: 3}
    Popup: {fileID: 0}
    sfx: {fileID: 0}
    sentences:
    - Your grandma?
  - name: Denali
    portrait: {fileID: 21300000, guid: 37666a48d1d431849a0bbda42fd7b28e, type: 3}
    Popup: {fileID: 0}
    sfx: {fileID: 0}
    sentences:
    - Our village elder. We might accompany you back.
  - name: Knut
    portrait: {fileID: 21300000, guid: 0819b2a39ff19584597e14c64d8fbdf0, type: 3}
    Popup: {fileID: 0}
    sfx: {fileID: 0}
    sentences:
    - "I see\u2026"
    - "Very well, let\u2019s go ahead."
