      m_Calls: []
  m_text: "\n\n\n\n\n\n\n\n\n\n<b>Gameplay Designer</b>\nPhilip Ankre\n\n\n<b>3D
    Artists</b>\nAmanda Ekman\nAmanda Svensson\nWictor Hjert\n\n\n<b>2D Artist</b>\nEllen
    Wikstr\xF6m\n\n\n<b>Music</b>\nAnders Lanhammar\n\n\n<b>Narrative Design and
    Story</b>\nPhilip Floden - Lead Writer\nDisa Berntsson Borglund\n\n\n<b>Programming
    </b>\nSamuel Eskilson \u2013 Lead Programmer\nEmily Runesson\nMarcus \u201CMackan\u201D
    Sv\xE4rd\n\n\n<b>Sound Design</b>\nLowe Bejmo \u2013 Lead Sound Designer\nAndreas
    M\xF6rne\n\n\n\n\n<b>Special Thanks to:</b>\n\nHelena Granstr\xF6m\n\nSteven
    Ekbrand \n\nOur wonderful coursemates for testing the game during development\n\n\n\n\n\n\n\nAnd
    you, the player, for giving our game a try <3\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 120203502b4efac4db49074606c34872, type: 2}
